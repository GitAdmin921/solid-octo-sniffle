# Copy this file to .env and fill in your own secrets.
# Generate a long random secret for Flask sessions.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=choose-a-strong-unique-password
PORT=5000

# Optional Telegram bot. Leave empty to run website only.
TELEGRAM_BOT_TOKEN=
# First run the bot and send /myid to learn your numeric Telegram user ID.
# Put only your own ID(s) here, comma-separated. Example: 123456789
ALLOWED_TELEGRAM_USER_IDS=

# Optional persistent database path. On hosting, use a persistent disk.
# DATABASE_PATH=/data/bharat-number-osint.sqlite3

# Optional OTP verification for numbers you can receive SMS on (Twilio Verify).
# This verifies control/access to a number only; it does NOT return SIM registration/KYC owner data.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
